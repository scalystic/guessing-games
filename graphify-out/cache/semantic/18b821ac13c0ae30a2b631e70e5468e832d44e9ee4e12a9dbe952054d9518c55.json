{"nodes": [{"id": "docs_game_engine_game_engine", "label": "Mode-Agnostic Game Engine", "file_type": "document", "source_file": "docs/game-engine.md", "source_location": "Game engine \u2014 run/round state machine", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One engine serves all games and modes so daily, practice, and future endless play share lifecycle, selection, scoring, and board logic."}, {"id": "docs_game_engine_puzzle", "label": "Puzzle", "file_type": "concept", "source_file": "docs/game-engine.md", "source_location": "Vocabulary", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_game_engine_reveal_stage", "label": "Reveal Stage", "file_type": "concept", "source_file": "docs/game-engine.md", "source_location": "Vocabulary", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_game_engine_attempt", "label": "Attempt", "file_type": "concept", "source_file": "docs/game-engine.md", "source_location": "Vocabulary", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_game_engine_round", "label": "Round", "file_type": "concept", "source_file": "docs/game-engine.md", "source_location": "Vocabulary", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_game_engine_run", "label": "Run", "file_type": "concept", "source_file": "docs/game-engine.md", "source_location": "Vocabulary", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_game_engine_daily_mode", "label": "Daily Mode", "file_type": "concept", "source_file": "docs/game-engine.md", "source_location": "Vocabulary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Daily is a bounded, comparable ten-round challenge with three lives and a frozen puzzle set shared by all players."}, {"id": "docs_game_engine_practice_mode", "label": "Practice Mode", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Run lifecycle", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Practice remains unbounded even after misses because terminating it would make persistent score, streak, and history appear to reset."}, {"id": "docs_game_engine_run_lifecycle", "label": "Run Lifecycle State Machine", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Run lifecycle", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_game_engine_round_lifecycle", "label": "Round Lifecycle State Machine", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Round lifecycle", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_game_engine_completed_state", "label": "Completed Run State", "file_type": "concept", "source_file": "docs/game-engine.md", "source_location": "Run lifecycle", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "COMPLETED is the only terminal state that writes leaderboard results."}, {"id": "docs_game_engine_abandoned_state", "label": "Abandoned Run State", "file_type": "concept", "source_file": "docs/game-engine.md", "source_location": "Run lifecycle", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An abandoned daily run scores nothing, preventing players from rerolling an unfavorable start."}, {"id": "docs_game_engine_expired_state", "label": "Expired Run State", "file_type": "concept", "source_file": "docs/game-engine.md", "source_location": "Run lifecycle", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_game_engine_server_authority", "label": "Server-Authoritative Game State", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Server authority \u2014 the non-negotiables", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server withholds pending answers and derives round index, stage, attempts, and score to prevent client-side cheating and stale-round mutation."}, {"id": "docs_game_engine_audio_range_prefix", "label": "Earned Audio Byte-Range Prefix", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Server authority \u2014 the non-negotiables", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each stage receives only its earned prefix, so the client cannot scrub into unrevealed audio."}, {"id": "docs_game_engine_cbr_mp3", "label": "CBR MP3 Reveal Asset", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Server authority \u2014 the non-negotiables", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CBR MP3 is used because a truncated MP3 remains decodable while a truncated MP4 does not."}, {"id": "docs_game_engine_content_addressed_storage", "label": "Content-Addressed Audio Storage", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Server authority \u2014 the non-negotiables", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checksum-based keys avoid leaking the song answer through human-readable storage URLs."}, {"id": "docs_game_engine_idempotency", "label": "Attempt Idempotency", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Server authority \u2014 the non-negotiables", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A retried mutation returns its stored result instead of consuming a second attempt."}, {"id": "docs_game_engine_row_locking", "label": "Run Row Locking", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Server authority \u2014 the non-negotiables", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SELECT FOR UPDATE plus a version increment prevents concurrent submits from both advancing the reveal ladder."}, {"id": "docs_game_engine_run_token", "label": "Run Mutation Token", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Server authority \u2014 the non-negotiables", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hashed per-run bearer token is required on mutations because possession of a player cookie alone must not authorize changing another run."}, {"id": "docs_game_engine_attempt_result", "label": "AttemptResult Response Contract", "file_type": "concept", "source_file": "docs/game-engine.md", "source_location": "API surface", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_game_engine_scoring_v1", "label": "Versioned Scoring Formula", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Scoring", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scoring is pinned per run so rebalancing cannot rewrite historical scores; XP stays flatter than competitive score to provide steady progression."}, {"id": "docs_game_engine_difficulty_curve", "label": "Within-Run Popularity Difficulty Curve", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Scoring and Puzzle selection", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Difficulty comes from catalog popularity and hook position rather than user-selectable tiers, preserving leaderboard comparability."}, {"id": "docs_game_engine_puzzle_selection", "label": "Popularity-Window Puzzle Selection", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Puzzle selection", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selection samples around a target popularity, excludes run repeats and recent player history, and widens the window when the catalog is thin."}, {"id": "docs_game_engine_popularity_self_tuning", "label": "Telemetry-Based Popularity Self-Tuning", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Difficulty self-tuning", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Observed early-solve rate is blended gradually into popularity while the seed remains unchanged, making retuning stable and reversible."}, {"id": "docs_game_engine_daily_challenge", "label": "Frozen Daily Challenge", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Daily challenge", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fixed platform timezone and one pre-generated ordered puzzle set keep the daily challenge comparable and recoverable."}, {"id": "docs_game_engine_guest_user_claim", "label": "Guest-to-User Claim Transaction", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Guest \u2192 user claim", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A unique guest claim and one transaction make migration of runs, stats, history, and leaderboard entries idempotent and one-way."}, {"id": "docs_game_engine_leaderboard_writes", "label": "Leaderboard Finalization Writes", "file_type": "rationale", "source_file": "docs/game-engine.md", "source_location": "Board writes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only ranked completed runs write boards; rank is derived on read rather than treated as durable truth."}, {"id": "docs_game_engine_prisma_7_setup", "label": "Prisma 7 Setup", "file_type": "document", "source_file": "docs/game-engine.md", "source_location": "Prisma 7 setup notes", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_game_engine_trigram_search", "label": "PostgreSQL Trigram Typeahead Search", "file_type": "concept", "source_file": "docs/game-engine.md", "source_location": "Prisma 7 setup notes", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_game_engine_player_history_cleanup", "label": "Player Puzzle History Cleanup", "file_type": "concept", "source_file": "docs/game-engine.md", "source_location": "Prisma 7 setup notes", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_game_engine_game_engine", "target": "docs_game_engine_run", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/game-engine.md", "source_location": "opening paragraph", "weight": 1.0}, {"source": "docs_game_engine_game_engine", "target": "docs_game_engine_round", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/game-engine.md", "source_location": "opening paragraph", "weight": 1.0}, {"source": "docs_game_engine_round", "target": "docs_game_engine_puzzle", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/game-engine.md", "source_location": "Vocabulary", "weight": 1.0}, {"source": "docs_game_engine_attempt", "target": "docs_game_engine_reveal_stage", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/game-engine.md", "source_location": "Vocabulary", "weight": 1.0}, {"source": "docs_game_engine_run", "target": "docs_game_engine_round", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/game-engine.md", "source_location": "Vocabulary", "weight": 1.0}, {"source": "docs_game_engine_daily_mode