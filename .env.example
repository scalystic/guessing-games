# Template — copy to .env and fill in. Committed, so keep it free of real values.
#
#   cp .env.example .env
#
# Generate each secret with:  openssl rand -base64 32

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Read by prisma.config.ts (Prisma 7 no longer takes a url in schema.prisma).
DATABASE_URL="postgresql://neondb_owner:npg_COJeUwA5Lkp8@ep-late-glade-azrnzzbs.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------
# Daily challenge
# ------------------------------------------------------------------
# ONE fixed timezone for the whole platform — never per-user.
DAILY_TZ="Asia/Kolkata"
DAILY_GENERATE_AHEAD_DAYS="2"
CRON_SECRET=""

# ------------------------------------------------------------------
# Identity — guest cookie + hashing
# ------------------------------------------------------------------
SESSION_SECRET=""
GUEST_COOKIE_NAME="gg_pid"
# Salt for Player.createdIpHash / Run.clientIpHash. Raw IPs are never stored.
IP_HASH_SALT=""

# ------------------------------------------------------------------
# Clip storage (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2)
# ------------------------------------------------------------------
# Holds the cumulative reveal clips only (<=7s each), never full tracks.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Bucket stays private; assets are signed per request, one stage at a time.
ASSET_CDN_BASE_URL=""
ASSET_URL_TTL_SECONDS="60"
ASSET_SIGNING_KEY=""

# ------------------------------------------------------------------
# Run engine
# ------------------------------------------------------------------
RUN_TTL_MINUTES="180"

# ------------------------------------------------------------------
# Ingest — popularity seeding + metadata (optional)
# ------------------------------------------------------------------
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# ------------------------------------------------------------------
# Auth — provider not chosen yet
# ------------------------------------------------------------------
# Player.authUserId is the join point into the game domain.
