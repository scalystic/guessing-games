# Template — copy to .env and fill in. Committed, so keep it free of real values.
#
#   cp .env.example .env
#
# Generate each secret with:  openssl rand -base64 32

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Read by prisma.config.ts (Prisma 7 no longer takes a url in schema.prisma).
DATABASE_URL="postgresql://neondb_owner:npg_COJeUwA5Lkp8@ep-late-glade-azrnzzbs.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Multiplayer's realtime layer (Socket.IO) runs as its own deployment — see
# the sargam-realtime-server repo — because Vercel can't host a persistent
# WebSocket server. This is that server's public URL. Local dev: run that
# repo locally (see its README) and point this at it, e.g. http://localhost:4000.
# Production: its Railway URL. Leave unset only if you're testing the
# multiplayer socket layer some other way — the "Multiplayer" button won't
# connect without this pointing at something real.
NEXT_PUBLIC_SOCKET_URL=""

# ------------------------------------------------------------------
# Daily challenge
# ------------------------------------------------------------------
# ONE fixed timezone for the whole platform — never per-user.
DAILY_TZ="Asia/Kolkata"
DAILY_GENERATE_AHEAD_DAYS="2"
CRON_SECRET=""

# ------------------------------------------------------------------
# Identity — guest cookie + hashing
# ------------------------------------------------------------------
SESSION_SECRET=""
GUEST_COOKIE_NAME="gg_pid"
# Salt for Player.createdIpHash / Run.clientIpHash. Raw IPs are never stored.
IP_HASH_SALT=""

# ------------------------------------------------------------------
# Clip storage (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2)
# ------------------------------------------------------------------
# One <=7s clip per puzzle, never a full track. Stages are byte-range prefixes
# of that single object, so the bucket must honour the HTTP Range header --
# `npm run verify:storage` checks exactly that before you rely on it.
#
# R2: the endpoint is the ACCOUNT endpoint with no bucket path, and the bucket
# name goes in S3_BUCKET separately. Region must stay "auto".
#   https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
# R2 dashboard > R2 > API > Manage API tokens > Create (Object Read & Write,
# scoped to this one bucket). "Access Key ID" and "Secret Access Key" only --
# the separate Cloudflare API token is for wrangler and is not used here.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# The bucket stays private and is never addressed directly by the browser: the
# stage route reads a range server-side and streams it back, because the range
# has to be authorized against RunRound.stageReached first. These are only
# needed if a public/CDN-fronted delivery path is added later -- leave empty.
ASSET_CDN_BASE_URL=""
ASSET_URL_TTL_SECONDS="60"
ASSET_SIGNING_KEY=""

# ------------------------------------------------------------------
# Run engine
# ------------------------------------------------------------------
RUN_TTL_MINUTES="180"

# ------------------------------------------------------------------
# Ingest — popularity seeding + metadata (optional)
# ------------------------------------------------------------------
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# ------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------
# Google OAuth API Keys
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ------------------------------------------------------------------
# YouTube Playlist Import (admin feature)
# ------------------------------------------------------------------
# Get a free key at: https://console.cloud.google.com → YouTube Data API v3.
# Enable "YouTube Data API v3" → Create credentials → API Key.
YOUTUBE_API_KEY=""

# ------------------------------------------------------------------
# Hook detection (yt-dlp + ffmpeg)
# ------------------------------------------------------------------
# yt-dlp ≥ 2026 is required — the system-installed version is often too old.
# Install the latest:  pip install -U yt-dlp --break-system-packages
# Then set the path to the newly installed binary:
YTDLP_PATH="/home/ayush/.local/bin/yt-dlp"

# Browser whose cookies yt-dlp uses to bypass YouTube bot-detection.
# Options: firefox | chrome | chromium | edge | safari
YTDLP_BROWSER="firefox"